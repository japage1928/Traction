# ---------------------------------------------------------------------------
# Traction environment
#
# Copy to `.env` and fill in. Everything prefixed VITE_ is compiled into the
# browser bundle and is therefore PUBLIC — never put a secret behind that
# prefix. Everything else is read only by Netlify Functions on the server.
# ---------------------------------------------------------------------------

# --- Supabase (browser) ----------------------------------------------------
# Project URL and anon key from Supabase → Project Settings → API.
# The anon key is safe to ship: every table is guarded by row-level security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server) -----------------------------------------------------
# Service-role key bypasses row-level security. Server-side only. Never expose.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic -------------------------------------------------------------
# Powers the AI advisor. Server-side only.
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# --- Token encryption ------------------------------------------------------
# 32-byte key, base64-encoded, used to encrypt stored OAuth tokens at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- App -------------------------------------------------------------------
# Public origin used to build OAuth redirect URIs. No trailing slash.
APP_URL=http://localhost:8888

# --- Social providers ------------------------------------------------------
# Each block is optional. A provider with no credentials configured simply
# shows as unavailable in the Accounts page; the rest of the app still works.

# X / Twitter — https://developer.x.com  (OAuth 2.0, PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Reddit — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube / Google — https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
