# ---------------------------------------------------------------------------
# Traction environment
#
# Copy to `.env` and fill in. Everything prefixed VITE_ is compiled into the
# browser bundle and is therefore PUBLIC — never put a secret behind that
# prefix. Everything else is read only by Netlify Functions on the server.
# ---------------------------------------------------------------------------

# --- Supabase (browser) ----------------------------------------------------
# Project URL and anon key from Supabase → Project Settings → API.
# The anon key is safe to ship: every table is guarded by row-level security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server) -----------------------------------------------------
# Service-role key bypasses row-level security. Server-side only. Never expose.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic -------------------------------------------------------------
# Powers the AI advisor. Server-side only.
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# --- Token encryption ------------------------------------------------------
# 32-byte key, base64-encoded, used to encrypt stored OAuth tokens at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- App -------------------------------------------------------------------
# Public origin used to build OAuth redirect URIs. No trailing slash.
APP_URL=http://localhost:8888

# --- Social providers ------------------------------------------------------
# Each block is optional. A provider with no credentials configured simply
# shows as unavailable on the Accounts page; the rest of the app still works.
#
# These are YOUR app's OAuth client credentials, registered once by you as the
# operator of this deployment. They are not user credentials: users never enter
# a platform password or an API key into Traction — they sign in on the
# platform's own domain and authorize this app there.
#
# Register this redirect URI with every provider, substituting the platform
# slug and your own origin:
#   {APP_URL}/.netlify/functions/oauth-callback?platform=<slug>

# X / Twitter — https://developer.x.com  (OAuth 2.0 + PKCE, slug: x)
# Redirect URI: {APP_URL}/api/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn — https://www.linkedin.com/developers/apps  (OAuth 2.0 + PKCE, slug: linkedin)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Reddit — https://www.reddit.com/prefs/apps  (type "web app", slug: reddit)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube / Google — https://console.cloud.google.com/apis/credentials
# Enable the YouTube Data API v3.  (OAuth 2.0 + PKCE, slug: youtube)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram — https://developers.facebook.com/apps  (slug: instagram)
# Add the "Instagram" product and use Instagram Login. Requires a Business or
# Creator account; personal accounts cannot grant these scopes.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# TikTok — https://developers.tiktok.com/apps  (Login Kit v2 + PKCE, slug: tiktok)
# Note TikTok calls the client id a "client key".
# Redirect URI: {APP_URL}/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Pinterest — https://developers.pinterest.com/apps  (API v5 + PKCE, slug: pinterest)
# Redirect URI: {APP_URL}/api/oauth/pinterest/callback
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
